# ==============================================================================
# Portfolio Server Configuration
# ==============================================================================
# Port for the HTTP server to listen on (default: 8080)
PORT=8080

# Environment mode (production, development)
APP_ENV=production

# SQLite database file path
# When running with Docker Compose, store inside the persistent /app/data volume:
DB_PATH=/app/data/portfolio.db

# ==============================================================================
# Security & Authentication (MANDATORY: Change in production!)
# ==============================================================================
# Secret key used for signing and verifying JWT tokens (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# CMS Console admin login credentials
ADMIN_USER=admin
ADMIN_PASS=replace_with_a_strong_admin_password
